{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  "include": [
    "app",
    "src",
    "scripts",
    "test/unit",
    "test/contract",
    "test/support",
    "test/fixtures",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["web-adapter", "test/adapter"]
}
