{
  "cli": {
    "version": ">= 17.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "ndk": "27"
      }
    },
    "e2e": {
      "extends": "preview",
      "env": {
        "CROSSFOG_E2E": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
